# Copy this file to cloud-init/tools/.env and edit it there. The local .env is the
# single configuration source for rendering and building template artifacts.
# Values are shell-like KEY=value entries, but commands are not evaluated.

# Guest site configuration
BRIDGE=vmbr991 # Set to your network bridge, remember that if you're on a vlan trunk you'll have to add the tag later
SYSLOG_SERVER=10.1.2.15 # if you don't have a syslog server just leave it as is
SYSLOG_PORT=5140 # if you don't have a syslog server just leave it as is
FAIL2BAN_IGNORE_IPS='127.0.0.1/8 ::1 10.1.10.100 10.1.2.19'
APPDATA_WWN=0x2000000000000001  # Don't need to change, it's what we use for the appdata disk
APPDATA_SERIAL=APPDATA  # Don't need to change, it's what we use for the appdata disk

# Template identities and local build inputs. Four consecutive VM IDs are used.
VMID_START=9000  # What VM ID to start with
NAME_PREFIX=deb13  # Prefix for the template names
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub  # The public key file for SSH access

# Bundle directory on the development server, relative to the repository root
ARTIFACT_OUTPUT_DIR=./cloud-init/build  # Where we will output the template files

# Destination storage and directory after copying the bundle to Proxmox
SNIPPET_STORAGE_NAME=local-zfs  # Name of the proxmox storage for the snippets
PROXMOX_SNIPPET_PATH=/mnt/pve/cloud-init/snippets  # Path to the snippets directory in Proxmox
ISO_STORAGE_PATH=/var/lib/vz/template/iso  # Path to the ISO templates directory in Proxmox

# VM storage
VM_STORAGE_NAME=local-zfs  # Name of the proxmox storage for the VMs

# VM sizing
CPU=4
MEM_MIN=1024
MEM_MAX=4096
APPDATA_DISK_SIZE=16
