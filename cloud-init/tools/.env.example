# Copy this file to cloud-init/tools/.env and edit it there. The local .env is the
# single configuration source for rendering and building template artifacts.
# Values are shell-like KEY=value entries, but commands are not evaluated.

# Guest site configuration
# Set to your network bridge, remember that if you're on a vlan trunk you'll have to add the tag later
BRIDGE=vmbr0
# if you don't have a syslog server just leave it as is
SYSLOG_SERVER=10.10.10.10
# if you don't have a syslog server just leave it as is
SYSLOG_PORT=514
FAIL2BAN_IGNORE_IPS='127.0.0.1/8 ::1 10.10.10.100 10.10.10.101'
# Don't need to change, it's what we use for the appdata disk
APPDATA_WWN=0x2000000000000001
# Don't need to change, it's what we use for the appdata disk
APPDATA_SERIAL=APPDATA

# Template identities and local build inputs. Four consecutive VM IDs are used.
# What VM ID to start with
VMID_START=9000
# Prefix for the template names
NAME_PREFIX=deb13
# The public key file for SSH access
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Where the generated template files will be stored. Safe to delete at any time.
ARTIFACT_OUTPUT_DIR=./cloud-init/build

# Destination storage after copying the bundle to Proxmox
# Name of the proxmox storage for the snippets. Proxmox resolves the snippets
# directory from this name, so there is no path to keep in sync.
SNIPPET_STORAGE_NAME=local
# Path to the ISO templates directory in Proxmox
ISO_STORAGE_PATH=/var/lib/vz/template/iso

# VM storage
# Name of the proxmox storage for the VMs
VM_STORAGE_NAME=local

# VM sizing
CPU=4
MEM_MIN=1024
MEM_MAX=4096
ROOT_DISK_SIZE=8
APPDATA_DISK_SIZE=16
